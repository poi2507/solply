# 개발: 로컬넷 (주최측 권장 — 무제한 반복)
SOLANA_RPC_URL=http://127.0.0.1:8899
SOLANA_NETWORK=localnet
# scripts/setup-localnet.sh 가 출력하는 값
USDC_MINT=

# 시연 직전 devnet 전환용 (Circle 공식 devnet USDC)
# SOLANA_RPC_URL=https://api.devnet.solana.com
# SOLANA_NETWORK=devnet
# USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# 에이전트 지갑 디렉터리 (hq/store-a/store-b/store-c.json) — 절대 커밋 금지
SOLPLY_WALLET_DIR=~/.config/solana/solply
PORT=3000
