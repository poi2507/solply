# --- Google AI ---
# AI Studio 무료 티어: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# gemini(AI Studio 무료) | vertex(GCP 크레딧·한도 여유) | mock(LLM 없이 규칙)
LLM_PROVIDER=gemini
HQ_MODEL=gemini-3.6-flash
STORE_MODEL=gemini-3.5-flash-lite

# Vertex AI 경유 시 필요 (LLM_PROVIDER=vertex)
#   1) gcloud auth application-default login
#   2) gcloud services enable aiplatform.googleapis.com --project <PROJECT_ID>
#   3) make vertex-check 로 확인
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# Vertex의 모델 이름은 AI Studio와 다를 수 있다
VERTEX_HQ_MODEL=gemini-2.5-flash
VERTEX_STORE_MODEL=gemini-2.5-flash-lite

# --- 저장소 ---
# local(JSON 파일) | postgres
SOLPLY_STORE=postgres
DATABASE_URL=postgresql://USER@localhost:5432/solply

# --- 연동 ---
PAYMENTS_API_URL=http://localhost:3000
