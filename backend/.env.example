# --- Google AI ---
# AI Studio 무료 티어: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# gemini(AI Studio 무료) | vertex(GCP 크레딧·한도 여유) | mock(LLM 없이 규칙)
LLM_PROVIDER=gemini
HQ_MODEL=gemini-3.6-flash
STORE_MODEL=gemini-3.5-flash-lite

# Vertex AI 경유 시 필요 (LLM_PROVIDER=vertex)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# --- 저장소 ---
# local(JSON 파일) | postgres
SOLPLY_STORE=postgres
DATABASE_URL=postgresql://USER@localhost:5432/solply

# --- 연동 ---
PAYMENTS_API_URL=http://localhost:3000
