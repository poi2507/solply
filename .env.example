# --- Google AI ---
# https://aistudio.google.com/apikey 에서 발급 (무료 티어 있음)
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=FALSE
# Vertex AI 사용 시 위를 TRUE로 바꾸고 아래 설정
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# --- Solana ---
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_NETWORK=devnet
# 에이전트 지갑 키페어 경로 (절대 커밋 금지)
SOLANA_KEYPAIR_PATH=~/.config/solana/hackathon.json
# devnet USDC mint (Circle 공식 devnet USDC)
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# --- Agent 정책 (자율 결제 한도) ---
AGENT_SPEND_LIMIT_USDC=10
