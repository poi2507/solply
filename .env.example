# 실제 값은 agent/.env 와 payments/.env 에 넣는다 (둘 다 gitignore 대상)

# === agent/.env ===
# https://aistudio.google.com/apikey 에서 발급 (GCP 결제 계정 없이 무료 티어 사용 가능)
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=FALSE
PAYMENTS_API_URL=http://localhost:3000
STORE_ID=store-a
AGENT_SPEND_LIMIT_USDC=50
# LLM 없이 규칙 기반으로 리허설: mock (온체인 결제는 실제로 발생)
LLM_PROVIDER=gemini

# 저장소: local(JSON 파일) | postgres
SOLPLY_STORE=postgres
DATABASE_URL=postgresql://USER@localhost:5432/solply

# === payments/.env ===
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_NETWORK=devnet
# 에이전트 지갑 디렉터리 (hq/store-a/store-b/store-c.json) — 절대 커밋 금지
SOLPLY_WALLET_DIR=~/.config/solana/solply
# Circle 공식 devnet USDC mint
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
PORT=3000
